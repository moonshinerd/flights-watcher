# Configurações do Telegram (Crie um bot no @BotFather para receber alertas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Intervalo entre checagens no modo 24/7 (em minutos)
CHECK_INTERVAL_MINUTES=60

# Intervalo mínimo entre alertas repetidos para o mesmo voo (em horas)
NOTIFICATION_COOLDOWN_HOURS=12

# Arquivos locais
DATABASE_PATH=flight_monitor.db
ROUTES_FILE=routes.json
DEFAULT_CURRENCY=BRL
