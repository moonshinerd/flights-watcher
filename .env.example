# Configurações de E-mail (Gmail SSL recomendado)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
ALERT_EMAIL_TO=seu-email@gmail.com

# Configurações do Telegram (Opcional - caso queira alertas também no celular)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Intervalo entre checagens no modo 24/7 (em minutos)
CHECK_INTERVAL_MINUTES=60

# Intervalo mínimo entre alertas repetidos para o mesmo voo (em horas)
NOTIFICATION_COOLDOWN_HOURS=12

# Arquivos locais
DATABASE_PATH=flight_monitor.db
ROUTES_FILE=routes.json
DEFAULT_CURRENCY=BRL
